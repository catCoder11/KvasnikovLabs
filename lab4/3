#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
vector<string> split(string str, char sep) {
	vector<string> str_vec;
	str = sep + str;
	while (str.find(sep) != string::npos) {
		int ind = str.rfind(sep);
		str_vec.push_back(str.substr(ind + 1));
		str.erase(ind);

	}
	reverse(str_vec.begin(), str_vec.end());
	return str_vec;
}

string join(vector<string>::iterator st, vector<string>::iterator end, string sep) {
	string result = "";
	for (auto it = st; it != end; it++) {
		result += *it + sep;
	}
	if (result != "") result.erase(result.size() - sep.size());
	return result;
}

