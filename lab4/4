#include <iostream>
#include <vector>
#include <algorithm>
#include <cctype>
using namespace std;

unsigned int findAll(string str, string sub) {
	unsigned int count = 0;
	while (str.find(sub) != string::npos) {
		count++;
		str.erase(0, str.find(sub) + sub.size());
	}
	return count;
}

void replAll(string& str, string old_str, string new_str) {
	while (str.find(old_str) != string::npos) {
		str.replace(str.find(old_str), old_str.size(), new_str);
	}
}

int main(int, char**) {
	setlocale(LC_ALL, "Russian");
	string str = "Programming is fun. C++ is powerful. Programming requires practice.";
	unsigned int counter = 0;
	unsigned int probels = 0;
	unsigned int dots = 0;
	for (char c : str) {
		if (c != ' ') {
			counter++;
		}
		else {
			probels++;
		}
		if (c == '.') {
			dots++;
		}
	}

	cout << "Всего символов: " << counter << endl;
	cout << "Всего слов: " << probels + 1 << endl;
	cout << "Всего предложений: " << dots << endl;
	cout << "Всего is: " << findAll(str, "is") << endl;
	transform(str.begin(), str.end(), str.begin(), ::toupper);
	for (int i = 0; i < 20; i++) {
		cout << str[i];
	}
	cout << endl;
	string new_str = str;
	replAll(new_str, ".", "!");
	cout << new_str;
}
