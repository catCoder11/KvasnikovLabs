#include <iostream>
#include <array>
#include <vector>
#include <list>
#include <random>
#include <chrono>
using namespace std;

template <typename F, typename... Args>
double getTime(F&& func, Args&&... args) {
    auto start = chrono::steady_clock::now();
    func(args...);
    auto end = chrono::steady_clock::now();
    chrono::duration<double, milli> elapsed = end - start;
    return elapsed.count();
}

int main(int, char**) {
    setlocale(LC_ALL, "ru");
    random_device rd;
    mt19937 gen(rd());
    uniform_int_distribution<> distrib(0, 1000);
    array<int, 100000> arr;
    vector<int> vec;
    list<int> listik;
    vec.resize(100000);
    for (int i = 0; i < 100000; i++) {
        arr[i] = distrib(gen);
        vec[i] = distrib(gen);
        listik.push_back(distrib(gen));
    }
    cout << "(Время в миллисекундах)" << endl;
    cout << endl;
    cout << "Обход элементов и сумма: " << endl;
    cout << endl;

    cout << "Время array:" << getTime([](array<int, 100000>& arr)
        {
            int sum = 0;
            for (int i = 0; i < 100000; i++) 
            {
                sum += arr[i];
            }
            cout << "Сумма: " << sum << endl;
        }, arr) << endl;
    cout << "Время vector:" << getTime([](vector<int>& vec)
        {
            int sum = 0;
            for (int i = 0; i < 100000; i++) {
                sum += vec[i];
            }
            cout << "Сумма: " << sum << endl;
        }, vec) << endl;
    cout << "Время list:" << getTime([](list<int>& listik)
        {
            int sum = 0;
            auto it = listik.begin();
            for (int i = 0; i < 100000; i++) {
                sum += *it;
                it++;
            }
            cout << "Сумма: " << sum << endl;
        }, listik) << endl;

    cout << endl;
    cout << "Произвольный доступ: " << endl;
    cout << endl;

    cout << "Время array:" << getTime([](array<int, 100000>& arr)
        {
            cout << "Элементы: " << arr[0] << " " << arr[25000] << " " << arr[50000] << " " << arr[75000] << " " << arr[99999] << endl;
        }, arr) << endl;
    cout << "Время vector:" << getTime([](vector<int>& vec)
        {
            cout << "Элементы: " << vec[0] << " " << vec[25000] << " " << vec[50000] << " " << vec[75000] << " " << vec[99999] << endl;
        }, vec) << endl;
    cout << "Время list:" << getTime([](list<int>& listik)
        {
            auto it = listik.begin();
            cout << "Элементы: "
                << *it << " "
                << *next(it, 25000) << " "
                << *next(it, 50000) << " "
                << *next(it, 75000) << " "
                << *next(it, 99999) << endl;
        }, listik) << endl;

    cout << endl;
    cout << "Вставка в конце: " << endl;
    cout << endl;

    cout << "[array не поддерживает]" << endl;
    cout << "Время vector:" << getTime([](vector<int>& vec)
        {
            for (int i = 0; i < 1000; i++) {
                vec.push_back(i);
            }
        }, vec) << endl;
    cout << "Время list:" << getTime([](list<int>& listik)
        {
            for (int i = 0; i < 1000; i++) {
                listik.push_back(i);
            }
        }, listik) << endl;

    cout << endl;
    cout << "Вставка в середине: " << endl;
    cout << endl;

    cout << "[array не поддерживает]" << endl;
    cout << "Время vector:" << getTime([](vector<int>& vec)
        {
            for (int i = 0; i < 100; i++) {
                vec.insert(vec.begin()+5000, i);
            }
        }, vec) << endl;
    cout << "Время list:" << getTime([](list<int>& listik)
        {
            auto it = listik.begin();
            for (int i = 0; i < 100; i++) {
                listik.insert(next(it, 5000), i);
            }
        }, listik) << endl;

    cout << endl;
    cout << "Удаление из середины: " << endl;
    cout << endl;

    cout << "[array не поддерживает]" << endl;
    cout << "Время vector:" << getTime([](vector<int>& vec)
        {
            for (int i = 0; i < 100; i++) {
                vec.erase(vec.begin()+5000);
            }
        }, vec) << endl;
    cout << "Время list:" << getTime([](list<int>& listik)
        {
            auto it = listik.begin();
            for (int i = 0; i < 100; i++) {
                listik.erase(next(it, 5000));
            }
        }, listik) << endl;

}
