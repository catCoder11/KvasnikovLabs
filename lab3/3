#include <iostream>
#include <string>
#include <array>
#include <vector>
#include <list>
#include <random>
#include <algorithm>
#include <iterator>
using namespace std;

struct Student {
	string name;
	int id;
	double gpa;
};

void printStud(Student& st) {
	cout << "<" << st.id << ">:'" << st.name << "'(" << st.gpa << ")" << endl;
}

int main() {
	setlocale(LC_ALL, "Russian");
	random_device rd;
	mt19937 gen(rd());
	uniform_int_distribution<> distrib(0, 10000);

	array<Student, 1000> arr;
	vector<Student> vec;
	list<Student> listik;

	//A,B
	for (int i = 0; i < 1000; i++) {
		Student st = { "Вася" + to_string(i), i, (double)(distrib(gen)) / 100 };
		arr[i] = st;
		vec.push_back(st);
		listik.push_back(st);
	}

	//C,D,E
	//По gpa
	auto gpa_sort = [](const Student& a, const Student& b) {return a.gpa > b.gpa; };
	sort(arr.begin(), arr.end(), gpa_sort);
	sort(vec.begin(), vec.end(), gpa_sort);
	listik.sort(gpa_sort);
	cout << "Сортировка по gpa:" << endl;
	for (int i = 0; i < 5; i++) {
		printStud(arr[i]);
	}
	cout << endl;

	//По id
	auto id_sort = [](const Student& a, const Student& b) {return a.id < b.id; };
	cout << "Сортировка по id:" << endl;
	sort(arr.begin(), arr.end(), id_sort);
	sort(vec.begin(), vec.end(), id_sort);
	listik.sort(id_sort);

	for (int i = 0; i < 5; i++) {
		printStud(vec[i]);
	}
	cout << endl;

	//По name
	auto name_sort = [](const Student& a, const Student& b) {return a.name < b.name; };
	cout << "Сортировка по name:" << endl;
	sort(arr.begin(), arr.end(), name_sort);
	sort(vec.begin(), vec.end(), name_sort);
	listik.sort(name_sort);

	auto it = listik.begin();
	for (int i = 0; i < 5; i++) {
		printStud(*it);
		it++;
	}
	cout << endl;



}
