#include <iostream>
#include <vector>
#include <list>
#include <array>
#include <iterator>
#include <random>
using namespace std;

void print_cont(vector<int>& vec, list<int>& listik) {
	for (int i = 0; i < vec.size(); i++) {
		cout << vec[i] << "  ";
	}
	cout << "\n\n";
	auto cur_el = listik.begin();
	for (int i = 0; i < listik.size(); i++) {
		cout << *cur_el++ << "  ";
	}
	cout << endl;
}
int main() {
	setlocale(LC_ALL, "Russian");
	array<int, 100> arr;
	vector<int> vec(100);
	list<int> listik(100);

	random_device rd;
	mt19937 engine(rd());
	uniform_int_distribution<int> dist(1, 1000);

	// Создание 100 случайных чисел для каждого массива
	generate(arr.begin(), arr.end(), [&]() {
		return dist(engine);
		});
	generate(vec.begin(), vec.end(), [&]() {
		return dist(engine);
		});
	generate(listik.begin(), listik.end(), [&]() {
		return dist(engine);
		});
	//array статичен. Все действия ниже нельзя выполнить с ним.

	cout << "Контейнеры до:" << endl;
	print_cont(vec, listik);
	cout << endl;
	//добавление в 50-ую позицию
	vec.insert(vec.begin() + 50, 999);
	auto it = listik.begin();
	advance(it, 50);
	listik.insert(it, 999);

	//удаление элемента с i=25
	vec.erase(vec.begin() + 25);
	advance(it, -25);
	listik.erase(it);

	//удаление всех m[i] > 500
	auto itvect = vec.begin();
	for (;itvect != vec.end(); )
	{
		if (*itvect > 500)
			itvect = vec.erase(itvect);
		else
			itvect++;
	}

	it = listik.begin();
	for (; it != listik.end(); )
	{
		if (*it > 500)
			it = listik.erase(it);
		else
			it++;
	}

	cout << "Контейнеры после:" << endl;
	print_cont(vec, listik);
	cout << endl;

	//Вывод оставшихся значений
	cout << "Осталось элементов: " << endl;
	cout << vec.size() << endl;
	cout << listik.size() << endl;
}
