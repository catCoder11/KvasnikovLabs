		throw std::invalid_argument("Ошибка открытия файла");
	}
	fout.write((char*)&p, sizeof(p));
	fout.close();
}

vector<Product> getProducts() {
	ifstream fin(FILE_NAME, ios::binary);
	if (!fin.is_open()) {
		throw std::invalid_argument("Ошибка открытия файла");
	}
	vector<Product> vec;
	Product pr;
	while (fin.read((char*)&pr, sizeof(pr))) {
		vec.push_back(pr);
	}
	fin.close();
	return vec;
}


void printProducts(const vector<Product>& vec) {
	for (const Product& p : vec) {
		p.print();
	}
}

Product findProduct(int id) {
	for (const Product& p : getProducts()) {
		if (p.get_id() == id) return p;
	}
	return Product();
}

float sumProducts() {
	float sum = 0;
	for (const Product& p : getProducts()) {
		sum += p.get_cost() * p.get_amount();
	}
	return sum;
}

