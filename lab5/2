	Product p2(2, "Стол", 199.99, 10);
	Product p3(3, "Кот в мешке", 9999.5, 1);
	addProduct(p1);
	addProduct(p2);
	addProduct(p3);

	printProducts(getProducts());
	printProduct(findProduct(2));
	cout << sumProducts() << endl;

	if (std::remove(FILE_NAME) == 0) {
		cout << "Файл успешно удален" << endl;
	}
}
