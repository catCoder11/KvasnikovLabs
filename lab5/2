using namespace std;
const int NAME_SIZE = 50;
const char* FILE_NAME = "products.bin";
struct Product {
private:
	int id;
	int amount;
	float cost;
	char name[NAME_SIZE + 1];

public:
	Product() : name(""), id(-1), amount(0), cost(0) {}
	Product(int id, const char* name, float cost, int amount) {
		this->set_id(id);
		this->set_name(name);
		this->set_cost(cost);
		this->set_amount(amount);
	}

	void set_id(const int& id) {
		this->id = id;
	}
	void set_amount(int amount) {
		if (amount < 0) throw std::invalid_argument("Число товаров не может быть отрицательным");
		this->amount = amount;
	}
	void set_cost(float cost) {
		if (cost < 0) throw std::invalid_argument("Цена не может быть отрицательным");
		this->cost = cost;
	}
	void set_name(const char* name) {
		if (strlen(name) > NAME_SIZE) throw std::invalid_argument("Слишком длинное название");
		strcpy_s(this->name, name);
	}

	int get_id() const {
		return id;
	}
	int get_amount() const {
		return amount;
	}
	float get_cost() const {
		return cost;
	}
	const char* get_name() const {
		return name;
	}

	void print() const {
		cout << "Id: " << id << "	Имя: " << name << "	Цена: " << cost << "	Кол-во: " << amount << endl;
	}
};


