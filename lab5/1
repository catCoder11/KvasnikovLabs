#include <cstdio>
using namespace std;

struct Student {
	string name="";
	int age=0;
	float grade=-1;
};

void addStudent(string& file_name, Student& st) {
	if (file_name.substr(file_name.size() - 4) != ".txt") {
		cout << "Неверный формат файла" << endl;
		return;
	}
	if (file_name.find(' ') != string::npos) {
		cout << "Некорректное имя студента" << endl;
	}
	ofstream fout(file_name, ios::app);
	if (!fout.is_open()) {
		cout << "Ошибка открытия файла. Sorry(" << endl;
		fout.close();
		return;
	}
	if (st.age <= 0 || st.name.size() == 0 || st.grade < 0) {
		cout << "Попытка сохранить неверные данные студента" << endl;
		fout.close();
		return;
	}
	fout << st.name << ' ' << st.age << ' ' << st.grade << endl;
	fout.close();
}
void addStudent(const char* file_name, Student& st) {
	string s = file_name;
	addStudent(s, st);
}

vector<Student> getStudents(string& file_name) {
	vector<Student> vec;
	if (file_name.substr(file_name.size() - 4) != ".txt") {
		cout << "Неверный формат файла" << endl;
		return vec;
	}
	ifstream fin(file_name);
	if (!fin.is_open()) {
		cout << "Студентов не будет. Ошибка. Нет такого файла" << endl;
		fin.close();
		return vec;
	}
	Student st;
	while (fin >> st.name >> st.age >> st.grade) {
		vec.push_back(st);
	}
	fin.close();
	return vec;
}
vector<Student> getStudents(const char* file_name) {
	string s = file_name;
	return getStudents(s);
}

void printStudents(vector<Student>& vec) {
	for (Student st : vec) {
		cout << st.name << " " << st.age << " " << st.grade << endl;
	}
}
void printStudents(vector<Student> vec) {
	for (Student st : vec) {
		cout << st.name << " " << st.age << " " << st.grade << endl;
	}
}


