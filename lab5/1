struct Student {
private:
	string name;
	int age;
	float grade;
public:
	Student(const string& new_name, int new_age, float new_grade) {
		setName(new_name);
		setAge(new_age);
		setGrade(new_grade);
	}

	void setName(const string& new_name) {
		if (new_name == "" || new_name.find(' ') != string::npos) {
			throw std::invalid_argument("Некорректное имя студента");
		}
		this->name = new_name;
	}
	void setAge(const int& new_age) {
		if (new_age < 0) {
			throw std::invalid_argument("Отрицальный возраст");
		}
		this->age = new_age;

	}
	void setGrade(const float& new_grade) {
		if (new_grade < 0 || new_grade > 100) {
			throw std::invalid_argument("Некорректная оценка студента");
		}
		this->grade = new_grade;
	}
	string getName() const { return name; }
	int getAge() const { return age; }
	float getGrade() const { return grade; }

	void print() const {
		cout << name << ' ' << age << ' ' << grade << endl;
	}
};

void addStudent(const string& file_name, const Student& st) {
	if (file_name.substr(file_name.size() - 4) != ".txt") {
		throw std::invalid_argument("Неверный формат файла");
	}
	ofstream fout(file_name, ios::app);
	if (!fout.is_open()) {
		throw std::invalid_argument("Такого файла нет");
	}

	fout << st.getName() << ' ' << st.getAge() << ' ' << st.getGrade() << endl;
	fout.close();
}

vector<Student> getStudents(const string& file_name) {
	vector<Student> vec;
	if (file_name.substr(file_name.size() - 4) != ".txt") {
		throw std::invalid_argument("Неверный формат файла");
	}
	ifstream fin(file_name);
	if (!fin.is_open()) {
		throw 42;
		throw std::invalid_argument("Нет такого файла");
	}
	string name;
	int age;
	float grade;
	while (fin >> name >> age >> grade) {
		vec.push_back(Student(name, age, grade));
	}
	fin.close();
	return vec;
}

void printAll(const string& file_name) {
	for (const Student& st : getStudents(file_name)) {
		st.print();
	}
}

