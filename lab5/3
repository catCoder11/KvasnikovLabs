#include <iostream>
#include <vector>
#include <algorithm>
#include <cctype>
#include <fstream>
#include <cstdio>
#include <cstring>
#include <sstream>
using namespace std;
const char* FILE_NAME = "sales.csv";
const char* FILTRED_FILE_NAME = "filtered_sales.csv";

struct Sale {
private:
	int customer_id;
	float cost;
	string sell_date;
	string type;
public:
	Sale() : customer_id(-1), cost(0), sell_date(""), type("") {}
	Sale(int id, float cost, string date, string type) {
		setId(id);
		setCost(cost);
		setDate(date);
		setType(type);
	}

	void setId(int id) {
		if (id < 0) throw std::invalid_argument("ID не может быть отрицательным");
		this->customer_id = id;
	}
	void setCost(float cost) {
		if (cost < 0) throw std::invalid_argument("Цена не может быть отрицательной");
		this->cost = cost;
	}
	void setDate(const string& date) {
		if (date == "" || date.find(',') != string::npos) {
			throw std::invalid_argument("Некорректная дата");
		}
		this->sell_date = date;
	}
	void setType(const string& type) {
		if (type == "" || type.find(',') != string::npos) {
			throw std::invalid_argument("Некорректный тип");
		}
		this->type = type;
	}

	int getId() const {
		return customer_id;
	}
	float getCost() const {
		return cost;
	}
	string getDate() const {
		return sell_date;
	}
	string getType() const {
		return type;
	}
	void print() const {
		cout << "Товар: " << type << "\tЦена: " << cost << "\tПокупатель: " << customer_id << "\tДата: " << sell_date << endl;
	}

};

vector<Sale> getSales(bool filter=false) {
	vector<Sale> vec;
	ifstream fin;
	if (filter) {
		fin = ifstream(FILTRED_FILE_NAME);
	}
	else {
		fin = ifstream(FILE_NAME);
	}
	if (!fin.is_open()) {
		throw std::invalid_argument("Ошибка открытия файла");
	}
	string line;
	while (getline(fin, line)) {
		stringstream ss(line);
		int customer_id;
		float cost;
		string sell_date;
		string type;
		ss >> customer_id;
		ss.ignore();
		ss >> cost;
		ss.ignore();
		getline(ss, sell_date, ',');
		getline(ss, type);
		vec.push_back(Sale(customer_id, cost, sell_date, type));
	}
	fin.close();
	return vec;
}

void addSale(const Sale& sale) {
	if (sale.getId() == -1) throw std::invalid_argument("Некорректный объект Sale");
	ofstream fout(FILE_NAME, ios::app);
	if (!fout.is_open()) {
		throw std::invalid_argument("Ошибка открытия файла");
	}
	fout << sale.getId() << ',' << sale.getCost() << ',' << sale.getDate() << ',' << sale.getType() << endl;
	fout.close();

}

double sumSales () {
	ifstream fin(FILE_NAME);
	if (!fin.is_open()) {
		throw std::invalid_argument("Ошибка открытия файла");
	}
	string line;
	double sum = 0;
	while (getline(fin, line)) {
		stringstream ss(line);
		int customer_id;
		float cost;
		ss >> customer_id;
		ss.ignore();
		ss >> cost;
		sum += cost;
	}
	fin.close();
	return sum;
}

void filterSales(string filterDate) {
	ofstream fout(FILTRED_FILE_NAME);
	if (!fout.is_open()) {
		throw std::invalid_argument("Ошибка открытия файла");
	}
	vector<Sale> vec = getSales();
	for (const Sale& sale : vec) {
		if (sale.getDate() == filterDate) 
			fout << sale.getId() << ',' << sale.getCost() << ',' << sale.getDate() << ',' << sale.getType() << endl;
	}
	fout.close();
}

void printAll() {
	for (const Sale& el : getSales()) {
		el.print();
	}
}
int main(int, char**) {
	setlocale(LC_ALL, "Russian");
	Sale sale1(10, 1099.99, "20260705", "стол");
	Sale sale2(15, 499.99, "20260305", "стул");
	Sale sale3(77, 304.56, "20260705", "ковёр за триста");
	addSale(sale1);
	addSale(sale2);
	addSale(sale3);
	printAll();
	filterSales("20260705");
	cout << "Продажи за 20260705:" << endl;
	for (const Sale& el : getSales(true)) {
		el.print();
	}
	remove(FILE_NAME);
}

