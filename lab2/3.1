#include <iostream>
using namespace std;

void printWeather(string* day, int* temp, bool* downFall, int id) {
    cout << "This day is " << day[id] << ", " << temp[id];
    switch (downFall[id]) {
    case true: {
        cout << " Celcia with downfall" << endl;
        break;
    }
    case false: {
        cout << " Celcia with no downfall" << endl;
        break;
    }
    }

}

void getHotDay(string* day, int* temp, bool* downFall, int n) {
    int id = 0;
    for (int i = 1; i < n; i++) {
        if (temp[i] > temp[id]) {
            id = i;
        }
    }
    printWeather(day, temp, downFall, id);

}

int main(int, char**) {
    setlocale(LC_ALL, "ru");
    const int COUNT = 7;
    string day[COUNT] = { "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday" };
    int temp[COUNT] = { 26,665,-27,-15,-20,0,13 };
    bool osadki[COUNT] = { false, true, false, false, true, false, false };

    cout << "Самый горячий день:" << endl;
    getHotDay(day, temp, osadki, COUNT);
}
