        cin >> x;
    }
}

struct Vehicle {
    int type;
    string model;
    int power;
    double volume;

};

void engineSort(Vehicle* vehicles, int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = i; j < n - 1; j++) {
            if (vehicles[j].power > vehicles[j + 1].power) {
                Vehicle sub = vehicles[j];
                vehicles[j] = vehicles[j + 1];
                vehicles[j + 1] = sub;
            }
        }
    }
}


void checkTime() {
    Vehicle array[1000];
    double time;
    for (int i = 0; i < 1000; i++) {
        array[i].power = 1000 - i;
    }
    clock_t start = clock();
    engineSort(array, 1000);
    time = (clock() - start) / (double)CLOCKS_PER_SEC;
    cout << time << " секунд на сортировку 1000 элементов" << endl;
}
