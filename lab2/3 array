#include <iostream>
using namespace std;

void printWeather(string* day, int* temp, bool* downFall, int id) {
    switch (downFall[id]) {
    case true: {
        cout << "This day is " << day[id] << ", " << temp[id] << " Celcia with downfall" << endl;
        break;
    }
    case false: {
        cout << "This day is " << day[id] << ", " << temp[id] << " Celcia with no downfall" << endl;
        break;
    }
    }
    
}
void getHotDay(string* day, int* temp, bool* downFall, int n) {
    int id = 0;
    for (int i = 1; i < n; i++) {
        if (temp[i] > temp[id]) {
            id = i;
        }
    }
    printWeather(day, temp, downFall, id);

}

int main(int, char**) {
    setlocale(LC_ALL, "ru");
    string day[7] = {
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
    };
    int temp[7] = {
        26,
        665,
        -27,
        -15,
        -20,
        0,
        13
    };
    bool downFall[7] = {
        false, true, false, false, true, false, false
    };

    getHotDay(day, temp, downFall, 7);
}
